# Configuración que cambia según el entorno. Copiá este archivo como .env si necesitás alguna.
#
# Las CLAVES (MySQL, JWT, SMTP) ya NO van acá: viven como archivos en secrets/ (Docker secrets).
# Creálos con:  powershell -ExecutionPolicy Bypass -File scripts\generar-secretos.ps1
# Ver "Secretos" en el README.

# Avisos y recordatorios por mail (opcional). Sin SMTP_HOST no se manda nada.
# La clave del servidor de mail va en secrets/smtp_password.txt
# Para probar sin mandar mails de verdad: SMTP_HOST=mailpit, SMTP_PORT=1025 y levantar con
#   docker compose --profile correo up --build   (bandeja en http://localhost:8025)
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_AUTH=true
#SMTP_STARTTLS=true
#SMTP_REMITENTE=turnos@tu-dominio.com
