# Copiá este archivo como .env y poné una clave propia (es obligatoria)
MYSQL_ROOT_PASSWORD=cambiame

# Clave con la que se firman los tokens de sesión (JWT). Obligatoria, mínimo 32 caracteres, y secreta:
# quien la conozca puede fabricar sesiones de cualquier usuario. Cambiarla cierra todas las sesiones.
# Para generar una: openssl rand -base64 48   (o cualquier texto largo y al azar)
JWT_SECRET=cambiame-por-un-texto-largo-y-al-azar-de-32-o-mas-caracteres

# Avisos y recordatorios por mail (opcional). Sin SMTP_HOST no se manda nada.
# Para probar sin mandar mails de verdad: SMTP_HOST=mailpit, SMTP_PORT=1025 y levantar con
#   docker compose --profile correo up --build   (bandeja en http://localhost:8025)
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_AUTH=true
#SMTP_STARTTLS=true
#SMTP_REMITENTE=turnos@tu-dominio.com
